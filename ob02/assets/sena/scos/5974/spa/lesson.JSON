: 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn7le04ob02re2img01.jpg", "audiosrc": "engenn7le04ob02re2aud01", "images": [{"time": "0", "image": "engenn7le04ob02re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn7le04ob02re2img05.jpg", "text": "<span class=\"strong\">Janet</span>: Hi Joe. I'm very glad to see you! <br/>\n<span class=\"strong\">Technician</span>: So, your printer has been giving you problems? <br/>\n<span class=\"strong\">Janet</span>: Actually, as of this morning, our printer hasn't given us anything! <br/>\n<span class=\"strong\">Technician</span>: Have you heard any unusual noises? <br/>\n<span class=\"strong\">Janet</span>: No, it has the same gentle hum as always. <br/>\n<span class=\"strong\">Technician</span>: Let's open this side panel and look inside. Ah, of course! The toner has run completely dry. Did you notice anything unusual before today?", "id": 1}, {"time": "25000", "image": "engenn7le04ob02re2img06.jpg", "text": "<span class=\"strong\">Janet</span>: Yes, all my sheets were printing out with streaks yesterday. In fact, I think I had several sheets print out where the ink looked a little blotchy. Do you want me to show you one? <br/>\n<span class=\"strong\">Technician</span>: I hate to tell you but the answer will be costly. The machine has become outdated. You'll need to replace it. <br/>\n<span class=\"strong\">Janet</span>: That's surprising. It's not that old. In fact, we purchased it less than three years ago. Aside from the toner it has run perfectly until now. <br/>\n<span class=\"strong\">Technician</span>: Unfortunately the industry has been producing new toners that do not match the old machines.", "id": 2}, {"time": "59000", "image": "engenn7le04ob02re2img07.jpg", "text": "<span class=\"strong\">Janet</span>: Would you advise me to find an old model with a good toner?  <br/>\n<span class=\"strong\">Technician</span>: Of course, but you will have the same issue again once the toner expires. I recommend a new machine.<br/>\n<span class=\"strong\">Janet</span>: Thanks for the advice. Would you suggest inkjet or laser?<br/>\n<span class=\"strong\">Technician</span>: I would go with laser. It's more expensive however they are faster and usually less problematic than the inkjet.<br/>\n<span class=\"strong\">Janet</span>: Of course, we'll put it in the budget immediately.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Preparing the Proposal"}, {"type": "unit_name", "content": "The Technician's Assessment"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 4}, {"type": "level", "content": "B1.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Present advice on solving technical problems in a work context and appropriate for the interlocutor."}, {"type": "secondary_1", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_2", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_3", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_4", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_5", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_6", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_7", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}, {"type": "secondary_8", "content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology."}]}, {"type": "background_image", "content": "engenn7le04ob02re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Using Expressions like <span class=\"italic\">of course</span> and <span class=\"italic\">in fact</span>"}, {"type": "describer", "content": " "}, {"type": "text", "content": "Using <span class=\"italic\">of course</span>"}, {"type": "text", "content": "<ul><li>To say \u201cyes\u201d as an answer to a question.<span class=\"italic\"><ul><li>\u201cDo you want help with the printer?\u201d<br/> \u201c<span class=\"strong\">Of course</span>.\u201d</li></ul></span></li></ul>"}, {"type": "text", "content": "<ul><li>To say that you agree or disagree with someone.</li><span class=\"italic\"><ul><li>\u201cI guess I need a new printer.\u201d <br/>\u201c<span class=\"strong\">Of course</span> you do.\u201d</li></ul></span></ul>"}, {"type": "text", "content": "<ul><li>To say something that you believe someone probably already knows or will not be surprised about.<span class=\"italic\"><ul><li>\u201c<span class=\"strong\">Of course</span>. The printer has run out of paper.\u201d </li></ul></span></li></ul>"}, {"type": "text", "content": "Using <span class=\"italic\">in fact</span>"}, {"type": "text", "content": "<ul><li>To add something to what you have just said, especially something that may seem surprising.<span class=\"italic\"><ul><li>The printer is new. <span class=\"strong\">In fact</span>, we purchased it less than two months ago.</li></ul></span></li></ul>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Asking for, Giving and Responding to Advice"}, {"type": "describer", "content": " "}, {"type": "text", "content": "In the workplace, you will often be requested to give, ask for, and respond to advice. "}, {"type": "text", "content": "The <span class=\"strong\">modal verb</span> <span class=\"italic\">should</span> is the most common way of giving advice. However, there are other ways to do that. "}, {"type": "text", "content": "<ul><li><span class=\"italic\">I hate to tell you but</span> ... + phrase<br/><span class=\"italic\"><span class=\"strong\">I hate to tell you this</span> but it is not going to be cheap.</span></li><li><span class=\"italic\">Do you want me to</span> + verb?<br/><span class=\"italic\"><span class=\"strong\">Do you want me to check</span> if the light is on?</span></li></ul>"}, {"type": "text", "content": "Other ways to ask for, give and respond to advice: "}, {"type": "table", "content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Asking for Advice\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Giving Advice\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responding to Advice\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Would you suggest</span> + verb <br/> <br/><span class=\\\"italic\\\">Would you recommend</span> + verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I would go with</span> ... + noun <br/> <br/><span class=\\\"italic\\\">I recommend</span> + noun / <span class=\\\"italic\\\">-ing </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Thanks for the advice. <br/> <br/>I'll keep it in mind.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "text", "content": "When it comes to giving advice, we normally use the word <span class=\"italic\">recommend</span>. It is, therefore, important to understand common patterns with the word <span class=\"italic\">recommend</span>."}, {"type": "text", "content": "<ol><li value=\"1\"><span class=\"italic\">recommend</span> + (<span class=\"italic\">that</span>) + clause <br/> <span class=\"italic\">I <span class=\"strong\">recommend that</span> you buy a more modern printer. </span></li></ol>"}, {"type": "text", "content": "<ol><li value=\"2\"><span class=\"italic\">strongly</span> + <span class=\"italic\">recommend</span> + pronoun + verb <br/> <span class=\"italic\">I <span class=\"strong\">strongly recommend you buy</span> a more modern printer. </span></li></ol>"}, {"type": "text", "content": "<ol><li value=\"3\"><span class=\"italic\">recommend</span> + <span class=\"italic\">-ing </span> <br/> <span class=\"italic\">I <span class=\"strong\">recommend</span> buy<span class=\"strong\">ing</span> a more modern printer. </span></li></ol>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "side panel"}, {"type": "definition", "content": "a removable piece from a printer that allows you to see inside a printer"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Let's open this side panel and look inside the printer."}, {"type": "audio", "content": "engenn7le04ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when solving a technical issue."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "outdated "}, {"type": "definition", "content": "no longer useful because of being old-fashioned"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The machine has become outdated."}, {"type": "audio", "content": "engenn7le04ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "toner "}, {"type": "definition", "content": "a type of ink used in printers"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The toner has run completely dry."}, {"type": "audio", "content": "engenn7le04ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to expire"}, {"type": "definition", "content": "to not be of use anymore"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You will have the same issue again once the toner expires."}, {"type": "audio", "content": "engenn7le04ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "laser printer"}, {"type": "definition", "content": "a printer that produces good quality printouts by means of a laser "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'm thinking of getting a laser printer."}, {"type": "audio", "content": "engenn7le04ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "inkjet "}, {"type": "definition", "content": "a printer that uses very small jets to blow ink onto paper in order to form letters, numbers, etc. "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I have an inkjet printer at home."}, {"type": "audio", "content": "engenn7le04ob02aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Choose a gadget from your office that you think does not work properly. "}, {"type": "text", "content": "Ask a partner for advice on what to do with it. "}, {"type": "text", "content": "Respond to your partner's advice (use \u201cin fact\u201d when possible)."}, {"type": "text", "content": "When you are finished, switch roles. You partner will ask you for advice and you will give him or her advice."}, {"type": "text", "content": "Decide whether you are going to keep the gadget or follow your partner's advice."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I identify a gadget that isn't working properly. "}, {"type": "text", "content": "I ask questions on how to fix it. "}, {"type": "text", "content": "I give and follow advice."}, {"type": "text", "content": "I use \u201cin fact\u201d when responding to advice."}]}]}